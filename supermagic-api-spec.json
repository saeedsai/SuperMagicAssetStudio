{
  "name": "SuperMagicAssetStudioAPI",
  "version": "5.4.0",
  "type": "browser-global",
  "global": "window.SuperMagicAssetStudioAPI",
  "methods": [
    {
      "name": "getProject",
      "returns": "ProjectObject"
    },
    {
      "name": "exportProjectObject",
      "args": [
        {
          "name": "options",
          "type": {
            "assetStorage": [
              "bundled",
              "external"
            ]
          }
        }
      ],
      "returns": "ProjectObject"
    },
    {
      "name": "getSummary",
      "returns": "SummaryObject"
    },
    {
      "name": "review",
      "returns": "ReviewObject"
    },
    {
      "name": "setMode",
      "args": [
        {
          "name": "mode",
          "enum": [
            "fullBody",
            "bodyHead",
            "standard",
            "custom"
          ]
        }
      ],
      "returns": "ProjectObject"
    },
    {
      "name": "setImageStorage",
      "args": [
        {
          "name": "mode",
          "enum": [
            "bundled",
            "external"
          ]
        }
      ],
      "returns": "string"
    },
    {
      "name": "importProjectObject",
      "args": [
        {
          "name": "project",
          "type": "ProjectObject"
        }
      ],
      "returns": "ProjectObject"
    },
    {
      "name": "resolveExternalImages",
      "args": [
        {
          "name": "files",
          "type": "FileList|File[]"
        }
      ],
      "returns": "Promise<void>"
    },
    {
      "name": "setView",
      "args": [
        {
          "name": "view",
          "type": "ViewId"
        }
      ],
      "returns": "string"
    },
    {
      "name": "setAnimation",
      "args": [
        {
          "name": "animationId",
          "type": "string"
        }
      ],
      "returns": "string"
    },
    {
      "name": "setFrame",
      "args": [
        {
          "name": "frameId",
          "type": "string"
        }
      ],
      "returns": "string"
    },
    {
      "name": "runCommands",
      "args": [
        {
          "name": "payload",
          "type": "CommandPayload"
        }
      ],
      "returns": "Promise<string>"
    },
    {
      "name": "saveJSON",
      "returns": "void"
    },
    {
      "name": "getPartDefinitions",
      "returns": "SuperMagicPartsObject"
    },
    {
      "name": "setPartDefinitions",
      "args": [
        {
          "name": "spec",
          "type": "SuperMagicPartsObject"
        }
      ],
      "returns": "SuperMagicPartsObject"
    },
    {
      "name": "exportPartDefinitions",
      "args": [
        {
          "name": "mode",
          "enum": [
            "fullBody",
            "bodyHead",
            "standard",
            "custom"
          ]
        }
      ],
      "returns": "SuperMagicPartsObject"
    },
    {
      "name": "openImageTools",
      "args": "mode: manual|auto|background",
      "returns": "void"
    },
    {
      "name": "loadImageToolsFile",
      "args": "file: File",
      "returns": "Promise<void>"
    },
    {
      "name": "autoSplitImage",
      "args": "canvas: HTMLCanvasElement,options: object",
      "returns": "Region[]"
    },
    {
      "name": "cropImageRegions",
      "args": "canvas: HTMLCanvasElement,regions: Region[]",
      "returns": "Promise<File[]>"
    },
    {
      "name": "removeImageBackground",
      "args": "canvas: HTMLCanvasElement,options: object",
      "returns": "{canvas,removed}"
    },
    {
      "name": "getDetectedRegions",
      "args": "none",
      "returns": "Region[]"
    },
    {
      "name": "magicWandRegion",
      "args": "canvas, seed: {x:number,y:number}, options?: {mode, tolerance, alphaThreshold}",
      "returns": "Region"
    },
    {
      "name": "getCurveOutline",
      "args": "region: BezierRegion,steps?: number",
      "returns": "Point[]"
    },
    {
      "name": "openStandaloneBackground",
      "args": "none",
      "returns": "void"
    }
  ],
  "commandOps": {
    "create": [
      "createProject",
      "setCanvas",
      "addAsset",
      "addLayer",
      "createAnimation",
      "addFrame",
      "addCustomPart"
    ],
    "modify": [
      "setProjectName",
      "setMode",
      "setImageStorage",
      "setView",
      "setAnimation",
      "setFrame",
      "selectLayer",
      "setLayer",
      "moveLayer",
      "deleteLayer",
      "setReference"
    ],
    "review": [
      "summary",
      "review"
    ]
  },
  "layerScopes": [
    "currentFrame",
    "currentAnimationCurrentView",
    "allCurrentView",
    "all"
  ],
  "views": [
    "front",
    "threeQuarterFrontLeft",
    "left",
    "threeQuarterBackLeft",
    "back",
    "threeQuarterBackRight",
    "right",
    "threeQuarterFrontRight"
  ],
  "cli": {
    "powershell_entrypoint": "SuperMagicAssetStudio.ps1",
    "node_entrypoint": "agent-cli.mjs",
    "operations_schema": "cli-command-schema.json",
    "reference": "CLI_API.md",
    "requires": "Node.js >=20, PowerShell 7+ or Windows PowerShell 5.1",
    "local_only": true
  }
}